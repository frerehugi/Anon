{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/v1/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  }
}
